      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "DisableCaching": true,
      "States": [
        { "Image": "imgs/actions/fan/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "Name": "Air Temp",
