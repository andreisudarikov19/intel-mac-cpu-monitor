{
  "Name": "Intel Mac Hardware Monitor",
  "Author": "Andrei Sudarikov",
  "Description": "Live thermal, fan, and power readouts on your Stream Deck for Intel Macs (T2 and pre-T2). Tap a key to switch the graph view to a slide; long-press to switch to a VU-meter view.",
  "Version": "1.4.1.0",
  "UUID": "dev.andreisudarikov.intel-mac-monitor",
  "SDKVersion": 3,
  "Icon": "imgs/plugin/icon",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Category": "Intel Mac Hardware Monitor",
  "CodePath": "bin/plugin.js",
  "OS": [
    { "Platform": "mac", "MinimumVersion": "13" }
  ],
  "Software": { "MinimumVersion": "6.9" },
  "Nodejs": { "Version": "20", "Debug": "enabled" },
  "Actions": [
    {
      "Name": "CPU Core Temp",
      "UUID": "dev.andreisudarikov.intel-mac-monitor.cpu-core",
      "Icon": "imgs/actions/cpu-core/icon",
      "Tooltip": "Live temperature of a specific CPU core (Intel only).",
      "PropertyInspectorPath": "ui/cpu-core.html",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "DisableCaching": true,
      "States": [
        { "Image": "imgs/actions/cpu-core/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "Name": "CPU Temp",
      "UUID": "dev.andreisudarikov.intel-mac-monitor.cpu",
      "Icon": "imgs/actions/cpu/icon",
      "Tooltip": "Live average CPU temperature across cores (Intel only).",
      "PropertyInspectorPath": "ui/cpu.html",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "DisableCaching": true,
      "States": [
        { "Image": "imgs/actions/cpu/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "Name": "GPU Temp",
      "UUID": "dev.andreisudarikov.intel-mac-monitor.gpu",
      "Icon": "imgs/actions/gpu/icon",
      "Tooltip": "Live GPU temperature (Intel only).",
      "PropertyInspectorPath": "ui/gpu.html",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "DisableCaching": true,
      "States": [
        { "Image": "imgs/actions/gpu/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "Name": "Fan Speed",
      "UUID": "dev.andreisudarikov.intel-mac-monitor.fan",
      "Icon": "imgs/actions/fan/icon",
      "Tooltip": "Live fan speed in RPM (Intel only).",
